.page {
  box-sizing: border-box;
  min-height: 100vh;
}

/* ---------- 加载 / 错误态 ---------- */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx;
}

.state-emoji {
  font-size: 88rpx;
}

.state-text {
  margin-top: var(--space-md);
  font-size: var(--font-base);
  color: var(--color-text-sub);
}

/* ---------- 画廊 ---------- */
.gallery {
  position: relative;
  width: 100%;
}

.gallery-swiper {
  width: 100%;
  height: 780rpx;
  background-color: rgba(255, 255, 255, 0.35);
}

.gallery-img,
.gallery-ph {
  width: 100%;
  height: 100%;
}

.gallery-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.gallery-emoji {
  font-size: 120rpx;
  opacity: 0.92;
}

.gallery-label {
  margin-top: var(--space-sm);
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.9);
}

.gallery-count {
  position: absolute;
  right: var(--space-md);
  bottom: var(--space-md);
  padding: 6rpx 24rpx;
  font-size: var(--font-sm);
  color: #ffffff;
  background-color: rgba(30, 24, 20, 0.38);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
}

/* ---------- 信息区 ---------- */
.info-wrap {
  padding: var(--space-md);
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.work-title {
  flex: 1;
  margin-right: var(--space-sm);
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.35;
}

/* ---------- 作者卡片 ---------- */
.author-card {
  display: flex;
  align-items: center;
  margin-top: var(--space-md);
  padding: var(--space-sm) var(--space-md);
}

.author-avatar {
  width: 92rpx;
  height: 92rpx;
  font-size: 38rpx;
}

.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: var(--space-sm);
}

.author-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
}

.author-class {
  margin-top: 4rpx;
  font-size: var(--font-sm);
  color: var(--color-text-sub);
}

.follow-btn {
  min-width: 152rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--color-primary);
  border: 2rpx solid rgba(200, 75, 49, 0.55);
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.follow-btn.followed {
  color: var(--color-text-weak);
  border-color: var(--color-line);
}

/* ---------- 创作说明（典雅排版） ---------- */
.desc-card {
  margin-top: var(--space-md);
  padding: var(--space-md);
}

.desc-title {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
}

.desc-body {
  margin-top: var(--space-sm);
  padding-left: var(--space-sm);
  border-left: 6rpx solid var(--color-accent);
  font-family: 'Kaiti SC', 'STKaiti', KaiTi, 'FZKai-Z03S', serif;
  font-size: var(--font-lg);
  color: #4A4038;
  line-height: 1.9;
  letter-spacing: 2rpx;
}

.desc-meta {
  margin-top: var(--space-sm);
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

/* ---------- 互动行 ---------- */
.action-row {
  display: flex;
  align-items: center;
  margin-top: var(--space-md);
  padding: var(--space-sm) var(--space-md);
}

.like-pill {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 150rpx;
  min-height: 72rpx;
  padding: 0 var(--space-md);
  background-color: rgba(200, 75, 49, 0.10);
  border: 1rpx solid rgba(200, 75, 49, 0.16);
  border-radius: 999rpx;
}

.like-heart {
  font-size: 36rpx;
  color: var(--color-text-sub);
}

.like-pill.liked .like-heart,
.like-pill.liked .like-num {
  color: var(--color-like);
}

.like-num {
  margin-left: 10rpx;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
}

.fav-pill {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 var(--space-md);
  margin-left: var(--space-sm);
  font-size: var(--font-sm);
  color: var(--color-text-sub);
  background-color: rgba(255, 255, 255, 0.50);
  border: var(--glass-border);
  border-radius: 999rpx;
}

.fav-pill.faved {
  color: var(--color-accent);
  background-color: var(--color-accent-light);
  border-color: rgba(232, 133, 61, 0.30);
}

.share-pill {
  margin-left: auto;
  min-height: 72rpx;
  padding: 0 var(--space-md);
  display: flex;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--color-text-sub);
  background-color: rgba(255, 255, 255, 0.50);
  border: var(--glass-border);
  border-radius: 999rpx;
  line-height: 1.4;
}

.share-pill::after {
  border: none;
}

/* ---------- 留言 ---------- */
.comment-card {
  padding: var(--space-xs) var(--space-md);
}

.comment-empty {
  padding: var(--space-lg) 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

.comment-item {
  display: flex;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-line);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 68rpx;
  height: 68rpx;
  font-size: 28rpx;
}

.comment-main {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-sm);
}

.comment-head {
  display: flex;
  align-items: center;
}

.comment-name {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text-sub);
}

/* 作者回复高亮标识（Z-06） */
.author-badge {
  margin-left: var(--space-xs);
  padding: 2rpx 16rpx;
  font-size: var(--font-sm);
  color: var(--color-primary);
  background-color: rgba(200, 75, 49, 0.10);
  border: 1rpx solid rgba(200, 75, 49, 0.18);
  border-radius: 999rpx;
}

.comment-content {
  margin-top: 6rpx;
  font-size: var(--font-base);
  color: var(--color-text);
  line-height: 1.6;
  word-break: break-all;
}

.comment-foot {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.comment-time {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

.comment-reply-btn {
  margin-left: var(--space-md);
  min-height: var(--touch-min);
  display: inline-flex;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* 删除按钮：与「回复」同排，弱化配色避免误触 */
.comment-del-btn {
  margin-left: var(--space-md);
  min-height: var(--touch-min);
  display: inline-flex;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

.reply-list {
  margin-top: var(--space-sm);
  padding: var(--space-sm);
  background-color: rgba(255, 255, 255, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-sm);
}

.reply-item {
  display: flex;
  padding: var(--space-xs) 0;
}

.reply-avatar {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  font-size: 22rpx;
}

.reply-body {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-xs);
}

/* 「回复 @xxx」前缀高亮 */
.reply-to {
  color: var(--color-primary);
}

.reply-item + .reply-item {
  border-top: 2rpx solid var(--color-line);
}

.bottom-space {
  height: 260rpx;
}

/* ---------- 底部固定留言栏（玻璃悬浮） ---------- */
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.72);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-top: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 -8rpx 32rpx rgba(120, 90, 60, 0.10);
}

.quick-scroll {
  white-space: nowrap;
}

.quick-row {
  display: inline-flex;
  padding: var(--space-xs) var(--space-md) 0;
}

.quick-chip {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 24rpx;
  margin-right: var(--space-sm);
  font-size: var(--font-sm);
  color: var(--color-text-sub);
  background-color: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
}

.input-row {
  display: flex;
  align-items: center;
  padding: var(--space-sm) var(--space-md);
}

.comment-input {
  flex: 1;
  min-height: 76rpx;
  padding: 0 var(--space-md);
  font-size: var(--font-base);
  color: var(--color-text);
  background-color: rgba(255, 255, 255, 0.60);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 999rpx;
}

.input-placeholder {
  color: var(--color-text-weak);
}

.cancel-reply {
  margin-left: var(--space-sm);
  min-height: var(--touch-min);
  display: inline-flex;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

.send-btn {
  margin-left: var(--space-sm);
  min-width: 132rpx;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(200, 75, 49, 0.30);
}

.send-disabled {
  opacity: 0.5;
}
