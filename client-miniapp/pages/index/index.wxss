.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: var(--space-lg);
}

/* ---------- 搜索框 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  margin: var(--space-sm) var(--space-md) 0;
  padding: 0 var(--space-sm);
  min-height: 76rpx;
  background-color: var(--color-card);
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
}

.search-icon {
  font-size: 30rpx;
  margin: 0 var(--space-xs);
}

.search-input {
  flex: 1;
  min-height: var(--touch-min);
  font-size: var(--font-base);
  color: var(--color-text);
}

.search-placeholder {
  color: var(--color-text-weak);
}

.search-clear {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: var(--color-text-weak);
  font-size: 28rpx;
}

/* ---------- 分类横滑栏 ---------- */
.cat-scroll {
  white-space: nowrap;
  margin-top: var(--space-sm);
}

.cat-row {
  display: inline-flex;
  padding: var(--space-xs) var(--space-md);
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: var(--touch-min);
  min-height: 64rpx;
  padding: 0 30rpx;
  margin-right: var(--space-sm);
  font-size: var(--font-base);
  color: var(--color-text-sub);
  background-color: var(--color-card);
  border-radius: 999rpx;
  border: 2rpx solid var(--color-border);
}

.cat-active {
  color: #ffffff;
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}

/* ---------- 排序切换 ---------- */
.sort-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-md) 0;
}

.sort-seg {
  display: flex;
  background-color: var(--color-card);
  border-radius: 999rpx;
  padding: 6rpx;
  box-shadow: var(--shadow-card);
}

.sort-item {
  min-width: 132rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  color: var(--color-text-sub);
  border-radius: 999rpx;
}

.sort-active {
  color: #ffffff;
  background-color: var(--color-primary);
  font-weight: 600;
}

.search-tip {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 340rpx;
}

/* ---------- 瀑布流 ---------- */
.waterfall {
  display: flex;
  padding: var(--space-md);
}

.column {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.column:first-child {
  margin-right: 20rpx;
}

.work-card {
  margin-bottom: 20rpx;
  background-color: var(--color-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

/* 封面：按 aspect（高/宽）撑出比例盒 */
.cover-box {
  position: relative;
  width: 100%;
}

.cover-img,
.cover-ph {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ph-emoji {
  font-size: 72rpx;
  opacity: 0.92;
}

.card-body {
  padding: var(--space-sm) var(--space-sm) 0;
}

.card-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-meta {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

.card-author {
  color: var(--color-text-sub);
}

.card-cat {
  color: var(--color-text-weak);
}

.card-foot {
  display: flex;
  justify-content: flex-end;
  padding: 0 var(--space-xs) var(--space-xs) 0;
}

/* ---------- 点赞 ---------- */
.like {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 96rpx;
  min-height: 64rpx;
  padding: 0 var(--space-sm);
}

.like-icon {
  font-size: 34rpx;
  color: var(--color-text-weak);
}

.like-count {
  margin-left: 8rpx;
  font-size: var(--font-sm);
  color: var(--color-text-sub);
}

.like.liked .like-icon {
  color: var(--color-like);
}

.like.liked .like-count {
  color: var(--color-like);
}

/* ---------- 空态 ---------- */
.empty {
  padding: 140rpx var(--space-md);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-emoji {
  font-size: 88rpx;
}

.empty-text {
  margin-top: var(--space-md);
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.empty-sub {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

/* ---------- 底部状态 ---------- */
.footer-tip {
  padding: var(--space-md) 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}
