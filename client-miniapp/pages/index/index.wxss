.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: var(--space-lg);
}

/* ---------- 搜索框（玻璃胶囊） ---------- */
.search-bar {
  display: flex;
  align-items: center;
  margin: var(--space-sm) var(--space-md) 0;
  padding: 0 var(--space-sm);
  min-height: 80rpx;
  background-color: var(--glass-bg-strong);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
}

.search-icon {
  font-size: 30rpx;
  margin: 0 var(--space-xs);
}

.search-input {
  flex: 1;
  min-height: var(--touch-min);
  font-size: var(--font-base);
  color: var(--color-text);
}

.search-placeholder {
  color: var(--color-text-weak);
}

.search-clear {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: var(--color-text-weak);
  font-size: 28rpx;
}

/* ---------- 分类横滑栏（透镜玻璃 chip：清透 + 激活透镜气泡） ---------- */
.cat-scroll {
  white-space: nowrap;
  margin-top: var(--space-sm);
}

.cat-row {
  display: inline-flex;
  padding: var(--space-xs) var(--space-md);
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: var(--touch-min);
  min-height: 64rpx;
  padding: 0 30rpx;
  margin-right: var(--space-sm);
  font-size: var(--font-base);
  color: var(--lens-text);
  background-color: var(--lens-bg);
  backdrop-filter: blur(30rpx) saturate(190%);
  -webkit-backdrop-filter: blur(30rpx) saturate(190%);
  border-radius: 999rpx;
  border: var(--lens-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.cat-active {
  color: var(--lens-text-active);
  background-color: var(--lens-bg-active);
  border-color: rgba(255, 255, 255, 0.95);
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(120, 90, 60, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 1);
}

/* ---------- 排序切换（透镜玻璃分段控件） ---------- */
.sort-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-md) 0;
}

.sort-seg {
  display: flex;
  background-color: var(--lens-bg);
  backdrop-filter: blur(30rpx) saturate(190%);
  -webkit-backdrop-filter: blur(30rpx) saturate(190%);
  border: var(--lens-border);
  border-radius: 999rpx;
  padding: 6rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.sort-item {
  min-width: 132rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  color: var(--lens-text);
  border-radius: 999rpx;
}

.sort-active {
  color: var(--lens-text-active);
  background-color: var(--lens-bg-active);
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(120, 90, 60, 0.16), inset 0 1rpx 0 rgba(255, 255, 255, 1);
}

.search-tip {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 340rpx;
}

/* ---------- 瀑布流 ---------- */
.waterfall {
  display: flex;
  padding: var(--space-md);
}

.column {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.column:first-child {
  margin-right: 20rpx;
}

.work-card {
  margin-bottom: 20rpx;
  background-color: var(--glass-bg-strong);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

/* 封面：按 aspect（高/宽）撑出比例盒 */
.cover-box {
  position: relative;
  width: 100%;
}

.cover-img,
.cover-ph {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ph-emoji {
  font-size: 72rpx;
  opacity: 0.92;
}

.card-body {
  padding: var(--space-sm) var(--space-sm) 0;
}

.card-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-meta {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

.card-author {
  color: var(--color-text-sub);
}

.card-cat {
  color: var(--color-text-weak);
}

.card-foot {
  display: flex;
  justify-content: flex-end;
  padding: 0 var(--space-xs) var(--space-xs) 0;
}

/* ---------- 点赞 ---------- */
.like {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 96rpx;
  min-height: 64rpx;
  padding: 0 var(--space-sm);
}

.like-icon {
  font-size: 34rpx;
  color: var(--color-text-weak);
}

.like-count {
  margin-left: 8rpx;
  font-size: var(--font-sm);
  color: var(--color-text-sub);
}

.like.liked .like-icon {
  color: var(--color-like);
}

.like.liked .like-count {
  color: var(--color-like);
}

/* ---------- 空态 ---------- */
.empty {
  margin: 100rpx var(--space-md) 0;
  padding: 80rpx var(--space-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.empty-emoji {
  font-size: 88rpx;
}

.empty-text {
  margin-top: var(--space-md);
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.empty-sub {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

/* ---------- 底部状态 ---------- */
.footer-tip {
  padding: var(--space-md) 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}
