<view class="page {{fontMode === 'large' ? 'font-large' : ''}}">

  <!-- 资料卡（Z-09） -->
  <view class="profile-card card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
      <image
        wx:if="{{userInfo.avatarUrl}}"
        class="profile-avatar"
        src="{{userInfo.avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="avatar-ph profile-avatar">{{userInfo.nickName ? userInfo.nickName[0] : '学'}}</view>
      <view class="avatar-badge">📷</view>
    </button>
    <view class="profile-main">
      <text class="profile-name">{{userInfo.nickName || '未填写姓名'}}</text>
      <text class="profile-sub">{{userInfo.className || '未填写班级'}}</text>
    </view>
  </view>

  <!-- 成就统计中心（Z-07） -->
  <view class="stats-card card">
    <view class="stat-item">
      <text class="stat-num">{{stats.works}}</text>
      <text class="stat-label">作品总数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.likes}}</text>
      <text class="stat-label">获赞总数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.comments}}</text>
      <text class="stat-label">收到留言</text>
    </view>
  </view>

  <!-- 资料行：姓名 / 班级（认定时提交，直接展示于此） -->
  <view class="rows-card card">
    <view class="row">
      <text class="row-label">姓名</text>
      <input
        class="row-input"
        type="nickname"
        value="{{userInfo.nickName}}"
        placeholder="填写姓名"
        placeholder-class="input-placeholder"
        bindblur="onNicknameBlur"
      />
    </view>
    <view class="row">
      <text class="row-label">班级</text>
      <text class="row-value">{{userInfo.className || '未填写'}}</text>
    </view>
  </view>

  <!-- 账号认定（G-07：学号绑定，认定通过后才能发布/评论） -->
  <view class="section-head">
    <text class="section-title">账号认定</text>
    <text class="section-extra">认定通过后可发布作品与评论</text>
  </view>
  <view class="bind-card card">
    <!-- 已认定 -->
    <view wx:if="{{bind.status === 'approved'}}" class="bind-row">
      <view class="bind-main">
        <text class="bind-title">已完成学号认定</text>
        <text class="bind-note" wx:if="{{bind.studentId}}">学号 {{bind.studentId}}{{bind.realName ? ' · ' + bind.realName : ''}}{{bind.className ? ' · ' + bind.className : ''}}，可正常发布作品与评论</text>
        <text class="bind-note" wx:else>存量账号已自动完成认定，可正常发布作品与评论</text>
      </view>
      <text class="tag tag-approved">已认定</text>
    </view>

    <!-- 待认定 -->
    <view wx:elif="{{bind.status === 'pending'}}" class="bind-row">
      <view class="bind-main">
        <text class="bind-title">认定审核中</text>
        <text class="bind-note">学号 {{bind.studentId}}{{bind.realName ? ' · ' + bind.realName : ''}}{{bind.className ? ' · ' + bind.className : ''}} 已提交，管理员认定通过后即可发布内容</text>
      </view>
      <text class="tag tag-pending">待认定</text>
    </view>

    <!-- 未绑定 / 已驳回 → 绑定表单 -->
    <block wx:else>
      <view wx:if="{{bind.status === 'rejected'}}" class="bind-reject">
        <text class="bind-reject-text">认定未通过：{{bind.rejectReason || '学号信息核对未通过'}}，请修正后重新提交</text>
      </view>
      <view wx:else class="bind-reject">
        <text class="bind-reject-text bind-tip">填写学号、姓名、班级并通过管理员认定后，才能发布作品与评论；未认定前可正常浏览</text>
      </view>
      <view class="bind-form">
        <view class="bind-field">
          <text class="bind-label">学号</text>
          <input
            class="bind-input"
            value="{{bindForm.studentId}}"
            placeholder="请输入本人学号"
            placeholder-class="input-placeholder"
            maxlength="20"
            bindinput="onBindIdInput"
          />
        </view>
        <view class="bind-field">
          <text class="bind-label">姓名</text>
          <input
            class="bind-input"
            value="{{bindForm.realName}}"
            placeholder="请输入真实姓名"
            placeholder-class="input-placeholder"
            maxlength="20"
            bindinput="onBindNameInput"
          />
        </view>
        <view class="bind-field">
          <text class="bind-label">班级</text>
          <input
            class="bind-input"
            value="{{bindForm.className}}"
            placeholder="如：视觉传达2201班"
            placeholder-class="input-placeholder"
            maxlength="30"
            bindinput="onBindClassInput"
          />
        </view>
        <text class="bind-form-note">姓名与班级将直接作为你的展示资料（作品作者名 / 班级），提交后可在上方查看</text>
        <button class="btn-primary bind-submit" disabled="{{bindSubmitting}}" bindtap="submitBind">
          {{bindSubmitting ? '提交中…' : (bind.status === 'rejected' ? '重新提交认定' : '提交认定申请')}}
        </button>
      </view>
    </block>
  </view>

  <!-- 审核状态追踪 -->
  <view class="section-head">
    <text class="section-title">审核状态追踪</text>
    <text class="section-extra">点击查看详情 / 驳回原因</text>
  </view>
  <view class="track-card card">
    <view wx:if="{{!tracking.length && !loading}}" class="track-empty">
      还没有提交过作品，去「发布」晒出你的创作吧
    </view>

    <view
      class="track-item"
      wx:for="{{tracking}}"
      wx:key="id"
      data-index="{{index}}"
      bindtap="statusTap"
    >
      <view class="track-thumb">
        <image
          wx:if="{{item.coverUrl}}"
          class="track-thumb-img"
          src="{{item.coverUrl}}"
          mode="aspectFill"
        />
        <view
          wx:else
          class="track-thumb-ph"
          style="background: {{item.coverMeta ? 'linear-gradient(160deg, ' + item.coverMeta.gradient[0] + ', ' + item.coverMeta.gradient[1] + ')' : '#E9E2D5'}};"
        >
          <text class="track-thumb-emoji">{{item.coverMeta.emoji}}</text>
        </view>
      </view>

      <view class="track-main">
        <text class="track-title">{{item.title}}</text>
        <text class="track-note">{{item.timeText}} 提交 · {{item.note || '审核中'}}</text>
      </view>

      <text class="tag {{item.statusCls}}">{{item.statusText}}</text>
    </view>
  </view>

  <!-- 我的作品：时间线瀑布流（带审核状态标签） -->
  <view class="section-head">
    <text class="section-title">我的作品</text>
    <text class="section-extra">按时间线排列</text>
  </view>

  <view class="waterfall" wx:if="{{!isEmpty}}">
    <view class="column">
      <view class="work-card" wx:for="{{leftList}}" wx:key="id">
        <view class="cover-box" style="padding-bottom: {{item.aspect * 100}}%;">
          <image
            wx:if="{{item.coverUrl}}"
            class="cover-img"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            lazy-load
          />
          <view
            wx:else
            class="cover-ph"
            style="background: {{item.coverMeta ? 'linear-gradient(160deg, ' + item.coverMeta.gradient[0] + ', ' + item.coverMeta.gradient[1] + ')' : '#E9E2D5'}};"
          >
            <text class="ph-emoji">{{item.coverMeta.emoji}}</text>
          </view>
        </view>
        <view class="work-body">
          <view class="work-title">{{item.title}}</view>
          <view class="work-foot">
            <text class="work-time">{{item.timeText}}</text>
            <view class="foot-right">
              <text class="tag {{item.statusCls}}">{{item.statusText}}</text>
              <text
                class="work-del-btn"
                data-id="{{item.id}}"
                catchtap="onDeleteWork"
              >删除</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="column">
      <view class="work-card" wx:for="{{rightList}}" wx:key="id">
        <view class="cover-box" style="padding-bottom: {{item.aspect * 100}}%;">
          <image
            wx:if="{{item.coverUrl}}"
            class="cover-img"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            lazy-load
          />
          <view
            wx:else
            class="cover-ph"
            style="background: {{item.coverMeta ? 'linear-gradient(160deg, ' + item.coverMeta.gradient[0] + ', ' + item.coverMeta.gradient[1] + ')' : '#E9E2D5'}};"
          >
            <text class="ph-emoji">{{item.coverMeta.emoji}}</text>
          </view>
        </view>
        <view class="work-body">
          <view class="work-title">{{item.title}}</view>
          <view class="work-foot">
            <text class="work-time">{{item.timeText}}</text>
            <view class="foot-right">
              <text class="tag {{item.statusCls}}">{{item.statusText}}</text>
              <text
                class="work-del-btn"
                data-id="{{item.id}}"
                catchtap="onDeleteWork"
              >删除</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 大字模式 / 设置与帮助 -->
  <view class="rows-card card setting-card">
    <view class="row">
      <text class="row-label">大字模式（适老化 · 22px）</text>
      <switch checked="{{fontMode === 'large'}}" color="#C84B31" bindchange="onFontSwitch" />
    </view>
    <view class="row" bindtap="openHelp">
      <text class="row-label">设置与帮助</text>
      <text class="chev">›</text>
    </view>
  </view>

  <view class="copyright">沐光·美育平台 v1.0</view>
</view>
