.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--space-md);
}

.form-card {
  padding: var(--space-md);
}

/* ---------- 图片宫格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-item {
  position: relative;
  width: 218rpx;
  height: 218rpx;
  border-radius: var(--radius-sm);
  overflow: visible;
}

.grid-img {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
  display: block;
}

.grid-del {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(200, 75, 49, 0.35);
  z-index: 2;
}

.grid-flag {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 2rpx 12rpx;
  font-size: var(--font-sm);
  color: #ffffff;
  background-color: rgba(30, 24, 20, 0.42);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 0 var(--radius-sm) 0 var(--radius-sm);
}

.grid-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(120, 100, 80, 0.28);
  border-radius: var(--radius-sm);
  background-color: rgba(255, 255, 255, 0.40);
  box-sizing: border-box;
}

.add-icon {
  font-size: 56rpx;
  color: var(--color-text-weak);
  line-height: 1.1;
}

.add-text {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  line-height: 1.5;
  text-align: center;
}

.grid-tip {
  margin-top: var(--space-sm);
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  line-height: 1.6;
}

/* ---------- 表单字段（玻璃输入底） ---------- */
.field-label {
  margin-top: var(--space-md);
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
}

.req {
  color: var(--color-primary);
}

.field-input {
  margin-top: var(--space-xs);
  min-height: 88rpx;
  padding: 0 var(--space-md);
  font-size: var(--font-base);
  color: var(--color-text);
  background-color: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-sm);
}

.field-textarea {
  margin-top: var(--space-xs);
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
  padding: var(--space-sm) var(--space-md);
  font-size: var(--font-base);
  color: var(--color-text);
  background-color: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-sm);
  line-height: 1.7;
}

.input-placeholder {
  color: var(--color-text-weak);
}

.char-count {
  margin-top: 6rpx;
  text-align: right;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

/* ---------- 分类（玻璃 chip） ---------- */
.cat-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-xs);
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: var(--touch-min);
  min-height: 64rpx;
  padding: 0 28rpx;
  margin: 8rpx 16rpx 0 0;
  font-size: var(--font-sm);
  color: var(--lens-text);
  background-color: var(--lens-bg);
  border: var(--lens-border);
  border-radius: 999rpx;
  backdrop-filter: blur(30rpx) saturate(190%);
  -webkit-backdrop-filter: blur(30rpx) saturate(190%);
}

.cat-active {
  color: var(--lens-text-active);
  background-color: var(--lens-bg-active);
  border-color: rgba(255, 255, 255, 0.95);
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(120, 90, 60, 0.16);
}

/* ---------- AI 润色 ---------- */
.ai-row {
  display: flex;
  align-items: center;
  margin-top: var(--space-md);
}

.ai-btn {
  min-width: 220rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(200, 75, 49, 0.30), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.ai-busy {
  opacity: 0.7;
}

.kw-input {
  flex: 1;
  min-height: 88rpx;
  margin-left: var(--space-sm);
  padding: 0 var(--space-md);
  font-size: var(--font-base);
  color: var(--color-text);
  background-color: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-sm);
}

.ai-tip {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  line-height: 1.6;
}

/* ---------- 底部操作（玻璃悬浮条） ---------- */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: var(--space-sm) var(--space-md);
  background-color: rgba(255, 255, 255, 0.72);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-top: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 -8rpx 32rpx rgba(120, 90, 60, 0.10);
  z-index: 10;
}

.draft-btn {
  flex: 1;
  margin-right: var(--space-sm);
}

.submit-btn {
  flex: 2;
}

.footer-space {
  height: 180rpx;
}
