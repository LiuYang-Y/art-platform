.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--space-md);
}

.form-card {
  padding: var(--space-md);
}

/* ---------- 图片宫格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-item {
  position: relative;
  width: 218rpx;
  height: 218rpx;
  border-radius: var(--radius-sm);
  overflow: visible;
}

.grid-img {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
  display: block;
}

.grid-del {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  background-color: var(--color-primary);
  border-radius: 50%;
  box-shadow: var(--shadow-card);
  z-index: 2;
}

.grid-flag {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 2rpx 12rpx;
  font-size: 18px;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.45);
  border-radius: 0 var(--radius-sm) 0 var(--radius-sm);
}

.grid-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

.add-icon {
  font-size: 56rpx;
  color: var(--color-text-weak);
  line-height: 1.1;
}

.add-text {
  font-size: 18px;
  color: var(--color-text-weak);
  line-height: 1.5;
  text-align: center;
}

.grid-tip {
  margin-top: var(--space-sm);
  font-size: 18px;
  color: var(--color-text-weak);
  line-height: 1.6;
}

/* ---------- 表单字段 ---------- */
.field-label {
  margin-top: var(--space-md);
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
}

.req {
  color: var(--color-primary);
}

.field-input {
  margin-top: var(--space-xs);
  min-height: 88rpx;
  padding: 0 var(--space-md);
  font-size: var(--font-base);
  color: var(--color-text);
  background-color: var(--color-bg);
  border-radius: var(--radius-sm);
}

.field-textarea {
  margin-top: var(--space-xs);
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
  padding: var(--space-sm) var(--space-md);
  font-size: var(--font-base);
  color: var(--color-text);
  background-color: var(--color-bg);
  border-radius: var(--radius-sm);
  line-height: 1.7;
}

.input-placeholder {
  color: var(--color-text-weak);
}

.char-count {
  margin-top: 6rpx;
  text-align: right;
  font-size: 18px;
  color: var(--color-text-weak);
}

/* ---------- 分类 ---------- */
.cat-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-xs);
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: var(--touch-min);
  min-height: 64rpx;
  padding: 0 28rpx;
  margin: 8rpx 16rpx 0 0;
  font-size: var(--font-sm);
  color: var(--color-text-sub);
  background-color: var(--color-bg);
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
}

.cat-active {
  color: #ffffff;
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}

/* ---------- AI 润色 ---------- */
.ai-row {
  display: flex;
  align-items: center;
  margin-top: var(--space-md);
}

.ai-btn {
  min-width: 220rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
  border-radius: var(--radius-sm);
  box-shadow: 0 6rpx 16rpx rgba(200, 75, 49, 0.25);
}

.ai-busy {
  opacity: 0.7;
}

.kw-input {
  flex: 1;
  min-height: 88rpx;
  margin-left: var(--space-sm);
  padding: 0 var(--space-md);
  font-size: var(--font-base);
  color: var(--color-text);
  background-color: var(--color-bg);
  border-radius: var(--radius-sm);
}

.ai-tip {
  margin-top: var(--space-xs);
  font-size: 18px;
  color: var(--color-text-weak);
  line-height: 1.6;
}

/* ---------- 底部操作 ---------- */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: var(--space-sm) var(--space-md);
  background-color: var(--color-card);
  border-top: 2rpx solid var(--color-border);
  z-index: 10;
}

.draft-btn {
  flex: 1;
  margin-right: var(--space-sm);
}

.submit-btn {
  flex: 2;
}

.footer-space {
  height: 180rpx;
}
