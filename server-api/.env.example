# ============================================================
# 配置模板：复制为 .env 后填入真实值（.env 已被 git 忽略，切勿入库）
# 填完执行：node scripts/check-env.js 做连通性自检
# ============================================================

PORT=3000
NODE_ENV=development

# ---------- 腾讯云 CloudBase ----------
# 环境 ID：CloudBase 控制台 → 环境概览
TENCENT_ENV_ID=your-env-id
# 密钥：https://console.cloud.tencent.com/cam/capi
# SecretId 形如 AKIDxxxx，SecretKey 为 32 位字母数字混合（创建时仅可见一次）
TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TENCENT_SECRET_KEY=your-32-char-secret-key
# 环境所在地域，默认 ap-shanghai
TENCENT_REGION=ap-shanghai

# ---------- JWT ----------
# 自定义一段复杂字符串即可
JWT_SECRET=change_me_to_a_random_string
JWT_EXPIRES_IN=7d

# ---------- 微信小程序 ----------
# https://mp.weixin.qq.com → 开发 → 开发管理 → 开发设置
# 注意：WECHAT_APPID/SECRET 未配置或 WECHAT_APPID=your_wx_appid 时，
# 后端 /api/user/login 自动进入「演示登录」模式（直登 seed 学员账号），
# 便于体验期发布/审核闭环真实落库；正式上线前必须填入真实值即自动切微信登录。
WECHAT_APPID=wx1234567890abcdef
WECHAT_SECRET=your_appsecret
# 演示登录默认身份 openid（seed 林小满 = seed_student_openid），可按需覆盖
# DEV_LOGIN_OPENID=seed_student_openid

# ---------- PostgreSQL 直连（pg 驱动，可选）----------
# 填齐 PG_HOST 后数据访问自动切换为 pg 直连（mode='pg-direct'），适合局域网/公网直连；
# 留空则走 CloudBase OpenAPI ExecutePGSql 通道（不依赖公网暴露数据库）。
# 取数位置：CloudBase 控制台 → 环境 → 云数据库 → PostgreSQL 实例 → 连接信息
# 注意：CloudBase PG 外网直连需先在控制台「开通外网访问」，通常强制 SSL
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=
# CloudBase 外网连接默认强制 SSL；本地自建 PG 想关掉 SSL 时填 false
PG_SSL=true
